<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".KotlinGuardApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KotlinGuard">

        <!--
             android:allowBackup="false": bookmark data lives only in the
             on-device Room DB (PLAN.md §12/D-07 — cloud sync is optional and
             not built), so there is nothing here worth an Auto Backup round
             trip, and it avoids leaking that DB to a restored device that
             hasn't passed IntegrityChecker verification yet.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KotlinGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
